    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "react": "^19.1.4",
    "react-dom": "^19.1.4",
    "react-router": "^7.12.0",
    "storybook": "^10.4.6",
    "typescript": "^5.9.3",
